# Laravel の標準の項目のうち、このサイトの .env には書いていないものの控え。
# Laravel は、このファイルを読まない。使うときに、要る行を .env へ写す。
# ここの値は、書かなかったときに使われる値（config/ の既定の値）と同じにしてある。

# ---- 既定の値のままで使っている項目 ----

# ログのチャンネル。stack 以外にすると、エラーの通知（ERROR_NOTIFY_LEVEL）が動かなくなる。
# ログのファイルの分け方は、LOG_STACK で変える
LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null

APP_LOCALE=ja
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=ja_JP

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

FILESYSTEM_DISK=local

# CACHE_PREFIX=

MAIL_SCHEME=null

# ---- 使っていない機能の項目 ----

BROADCAST_CONNECTION=log

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
