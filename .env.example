APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

# サーバーの前にロードバランサーやCDNを置いたときだけ書く。そのIPアドレスをカンマ区切りで
# （範囲は192.168.0.0/24の形）。ここに書いたプロキシから届いたX-Forwarded-Forを、訪問者の
# IPアドレスとして使う。置いていなければ空のまま（書くと、IPアドレスを偽れるようになる）
TRUSTED_PROXIES=

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

# お問い合わせフォームのメール宛先
CONTACT_STAFF_EMAIL=staff@example.com

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"
# 一斉メールを1分に送る通数の上限。SMTPの送信の上限を超えない値にする。
# さくらのレンタルサーバは15分に100通ほどが目安なので、ほかのメールの分を残して5にしている
MAIL_BULK_PER_MINUTE=5

# ログのファイル（storage/logs）
# LOG_STACK：single は laravel.log の1つに書き続ける（手元の開発用。消す仕組みは無い）。
#            daily は laravel-日付.log に1日1ファイルで書き、古いものを消す（サーバーではこちらにする）
# LOG_DAILY_DAYS：daily のときに残す日数
LOG_CHANNEL=stack
LOG_STACK=single
LOG_DAILY_DAYS=90
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug
# 操作ログ（管理画面の「操作ログ」。t_operation_logs）を残す日数
OPERATION_LOG_DAYS=365
# 操作ログの報告のメールの宛先。カンマ区切りで複数書ける。空なら送らない。
# 毎朝、前の日に気になる点（詳細の閲覧やCSVのダウンロードが多い、など）があったときだけ送る
OPERATION_REPORT_TO=

# ログイン後の管理画面で、1人のスタッフが1分に送れる回数。超えた回は処理せず、操作ログに残す
ADMIN_REQUESTS_PER_MINUTE=120

# エラーの通知（App\Support\ErrorNotifyHandler）
# ERROR_NOTIFY_LEVEL：知らせる最低のレベル（空：送らない、critical：障害、error：運用支障、warning：気になるものまで）
# ERROR_NOTIFY_TO：宛先。カンマ区切りで複数書ける
# ERROR_NOTIFY_INTERVAL：同じ内容の通知を間引く間隔（分）。間引いた件数は次の通知に記載する
ERROR_NOTIFY_LEVEL=
ERROR_NOTIFY_TO=
ERROR_NOTIFY_INTERVAL=10

APP_LOCALE=ja
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=ja_JP

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Cloudflare Turnstile（お問い合わせのスパム対策。App\Support\SpamGuard）
# 本番はCloudflareのダッシュボードでドメインごとに発行した鍵。手元の開発では、Cloudflareのテスト用の鍵
# （必ず通る：TURNSTILE_SITE_KEY=1x00000000000000000000AA、TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA）
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
