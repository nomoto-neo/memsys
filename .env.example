# このファイルに書くのは、サーバーごとに違う値と、秘密の値だけ。
# どのサーバーでも同じ値（残す日数や回数など、サイトの決まりごと）は、config/ のファイルに書く。
# ここに無い Laravel の標準の項目は、.env.unused にある。

# ---- サイトの基本 ----

# サイトの、機械の名前。半角の英数字で書く。セッションのCookieやキャッシュの名前の頭になる
APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
# 画面やメールに出す、サイトの名前。日本語で書いてよい。空なら、画面にもメールにも名前は出ない
SITE_NAME=

# ---- 接続元の制限 ----

# サーバーの前にロードバランサーやCDNを置いたときだけ、信頼できるPROXYのIPを
# カンマ区切りで書く。（～/24の形で範囲も可）
# ここに書いたプロキシから届いたX-Forwarded-Forを、訪問者のIPアドレスとして使う。
# ここに書いたIPから接続した人は、IPアドレスを偽れるようになるので、正確に書く。
# PROXYを通さないときは空のまま。
TRUSTED_PROXIES=

# サイト（訪問者画面）に制限を掛けているときも開けるIPアドレス。カンマ区切りで書く。（～/24の形で範囲も可）
# 制限を掛けるかは、管理画面の「アクセス制限」で決める。ここに書いたIPは、画面からは外せない。
SITE_ALLOWED_IPS=

# 管理画面に制限を掛けているときも開けるIPアドレス。書き方は同じ。
# 制限を掛けるかは、管理画面の「アクセス制限」で決める。ここに書いたIPは、画面からは外せない。
# ここに書いたIPは、サイトに制限を掛けているときも開ける。
ADMIN_ALLOWED_IPS=

# ---- DB ----

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

# ---- 保存先の種類 ----

# セッション・キャッシュ・キューを置く場所。どれもDBに置く。
# キューをDBに置くのは、一斉メールをcronだけで送るため
SESSION_DRIVER=database
CACHE_STORE=database
QUEUE_CONNECTION=database

# サーバーでcronが動くか。動かないサーバーだけfalseにする。falseにすると、cronの代わりに、
# サイトへのアクセスを契機にスケジューラーの予定（一時データの片付け・キューなど）を動かす
CRON_ENABLED=true

# ---- メールの接続 ----

MAIL_MAILER=log
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${SITE_NAME}"
# 届かなかったときのエラーのメールが戻る先。すべてのメールに付く。空なら送信元に戻る。送信元と同じドメインにする
MAIL_RETURN_PATH=
# 一斉メールを1分に送る通数の上限。SMTPの送信の上限を超えない値にする。
# さくらのレンタルサーバは15分に100通ほどが目安なので、ほかのメールの分を残して5にしている
MAIL_BULK_PER_MINUTE=5
# 一斉メールの宛先のCSVを読むときに、メールアドレスのドメインがDNSにあるかを確かめるか
MAIL_BULK_CHECK_DOMAIN=true

# ---- メールの宛先 ----

# お問い合わせフォームのメール宛先
CONTACT_STAFF_EMAIL=staff@example.com

# 企業会員の登録の申請を知らせるメール宛先
COMPANY_REGISTRATION_STAFF_EMAIL=staff@example.com

# 操作ログの報告のメールの宛先。カンマ区切りで複数書ける。空なら送らない。
# 毎朝、前の日に気になる点があったときだけ送る
OPERATION_REPORT_TO=

# ---- ログと、エラーの通知 ----

# ログのファイル（storage/logs）の分け方。
# single は laravel.log の1つに書き続ける（手元の開発用。消す仕組みは無い）。
# daily は laravel-日付.log に1日1ファイルで書き、古いものを消す（サーバーではこちらにする）。
# 残す日数は、config/logging.php の daily の max_files
LOG_STACK=single
LOG_LEVEL=debug

# エラーの通知（Neobit\Core\Operations\ErrorNotifyHandler）
# ERROR_NOTIFY_LEVEL：知らせる最低のレベル（空：送らない、critical：障害、error：運用支障、warning：気になるものまで）
# ERROR_NOTIFY_TO：宛先。カンマ区切りで複数書ける
ERROR_NOTIFY_LEVEL=
ERROR_NOTIFY_TO=

# ---- 秘密の鍵 ----

# Cloudflare Turnstile（お問い合わせのスパム対策。Neobit\Core\Security\SpamGuard）
# 本番はCloudflareのダッシュボードでドメインごとに発行した鍵。手元の開発では、Cloudflareのテスト用の鍵
# （必ず通る：TURNSTILE_SITE_KEY=1x00000000000000000000AA、TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA）
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
