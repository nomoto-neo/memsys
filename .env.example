# サイトの、機械の名前。半角の英数字で書く。セッションのCookieやキャッシュの名前の頭になる
APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
# 画面やメールに出す、サイトの名前。日本語で書いてよい。空ならAPP_NAMEを使う
SITE_NAME=

# サーバーの前にロードバランサーやCDNを置いたときだけ、信頼できるPROXYのIPを
# カンマ区切りで書く。（～/24の形で範囲も可）
# ここに書いたプロキシから届いたX-Forwarded-Forを、訪問者のIPアドレスとして使う。
# ここに書いたIPから接続した人は、IPアドレスを偽れるようになるので、正確に書く。
# PROXYを通さないときは空のまま。
TRUSTED_PROXIES=

# サイト全体を閲覧できるIPアドレス。
# 公開前のデモの運用やメンテナンスの間だけ解放したいIPをカンマ区切りで書く。（～/24の形で範囲も可）
# ここに無いIPアドレスにはメンテナンス中の画面を出す。空なら制限しない。
SITE_ALLOWED_IPS=

# 管理画面を開けるIPアドレス。書き方は同じ。
# ここに無いIPアドレスには、ログイン画面も含めて404を返す。空なら制限しない。
ADMIN_ALLOWED_IPS=

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

# お問い合わせフォームのメール宛先
CONTACT_STAFF_EMAIL=staff@example.com

# 企業会員の登録の申請を知らせるメール宛先
COMPANY_REGISTRATION_STAFF_EMAIL=staff@example.com

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${SITE_NAME}"
# 一斉メールを1分に送る通数の上限。SMTPの送信の上限を超えない値にする。
# さくらのレンタルサーバは15分に100通ほどが目安なので、ほかのメールの分を残して5にしている
MAIL_BULK_PER_MINUTE=5

# ログのファイル（storage/logs）
# LOG_STACK：single は laravel.log の1つに書き続ける（手元の開発用。消す仕組みは無い）。
#            daily は laravel-日付.log に1日1ファイルで書き、古いものを消す（サーバーではこちらにする）
# LOG_DAILY_DAYS：daily のときに残す日数
LOG_CHANNEL=stack
LOG_STACK=single
LOG_DAILY_DAYS=90
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# 操作ログ（管理画面の「操作ログ」。t_operation_logs）を残す日数
OPERATION_LOG_DAYS=365

# 操作ログの報告のメールの宛先。カンマ区切りで複数書ける。空なら送らない。
# 毎朝、前の日に気になる点があったときだけ送る
OPERATION_REPORT_TO=

# お問い合わせ履歴と添付ファイルを残す日数。過ぎたものは自動で消す。空なら消さずに残し続ける
INQUIRY_KEEP_DAYS=

# ログイン後の管理画面で、1人のスタッフが1分に送れる回数。超えた回は処理せず、操作ログに残す
ADMIN_REQUESTS_PER_MINUTE=120

# エラーの通知（App\Support\ErrorNotifyHandler）
# ERROR_NOTIFY_LEVEL：知らせる最低のレベル（空：送らない、critical：障害、error：運用支障、warning：気になるものまで）
# ERROR_NOTIFY_TO：宛先。カンマ区切りで複数書ける
# ERROR_NOTIFY_INTERVAL：同じ内容の通知を間引く間隔（分）。間引いた件数は次の通知に記載する
ERROR_NOTIFY_LEVEL=
ERROR_NOTIFY_TO=
ERROR_NOTIFY_INTERVAL=10

APP_LOCALE=ja
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=ja_JP

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Cloudflare Turnstile（お問い合わせのスパム対策。App\Support\SpamGuard）
# 本番はCloudflareのダッシュボードでドメインごとに発行した鍵。手元の開発では、Cloudflareのテスト用の鍵
# （必ず通る：TURNSTILE_SITE_KEY=1x00000000000000000000AA、TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA）
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
